# Kopyala: .env  (ASLA commit etme)
TRADING_MODE=paper

# Sabit çıkış IP (deploy/README.md)
# Yalnızca egress.mode=proxy|managed_proxy için. Örnek: socks5h://kullanici:parola@VPS_IP:1080
EGRESS_PROXY_URL=
# VPS'in reserved public IP'si (testnet/live için zorunlu)
EGRESS_EXPECTED_IP=0.0.0.0

# Binance (sadece okuma + işlem izni; para çekme KAPALI; IP whitelist = EGRESS_EXPECTED_IP)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# BTCTurk
BTCTURK_API_KEY=
BTCTURK_API_SECRET=

# Diğer borsalar (docs/BORSALAR.md). Desen: <AD>_API_KEY / <AD>_API_SECRET / <AD>_API_PASSWORD
# (passphrase: OKX, KuCoin, Bitget), testnet için <AD>_TESTNET_API_KEY ... Örnek:
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSWORD=
# OKX_TESTNET_API_KEY=
# OKX_TESTNET_API_SECRET=
# OKX_TESTNET_API_PASSWORD=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
# Ad listesi: binance bingx bitfinex bitget bithumb bitstamp bitvavo btcturk bybit coinbase
#             cryptocom gate gemini htx kraken kucoin mexc okx poloniex upbit whitebit

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Heartbeat (harici izleme, ör. healthchecks.io / Uptime Kuma push URL'si)
HEARTBEAT_URL=

# Panel
API_AUTH_TOKEN=

# Veritabanı (docker-compose postgres kullanır; DATABASE_URL compose içinde ezilir)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
POSTGRES_PASSWORD=

# Opsiyonel: LLM yorumu
ANTHROPIC_API_KEY=
